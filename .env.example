# Шаблон переменных окружения (12-factor, PRD FR-DOC-5).
# Скопируйте в .env и подставьте значения. .env в git НЕ коммитится (.gitignore).
# Реальные значения для CI/Vercel кладите в GitHub Secrets / Vercel env, НЕ сюда.

# --- Supabase Postgres (ADR-0013) ---
# Transaction pooler (порт 6543) — рантайм (GitHub Actions, бот, локально):
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct/Session — миграции Alembic. Прямой хост db.<ref>.supabase.co IPv6-only и
# часто недоступен; код сам выводит Session pooler (порт 5432) из DATABASE_URL,
# поэтому эту строку можно не задавать.
# DATABASE_URL_DIRECT=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=<TOKEN_ОТ_BOTFATHER>
# Произвольная случайная строка (буквы+цифры). Защищает webhook (FR-TG-1).
# То же значение задаётся в переменных окружения Vercel.
TELEGRAM_WEBHOOK_SECRET=<СЛУЧАЙНАЯ_СТРОКА>
